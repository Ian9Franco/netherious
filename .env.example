# Netherious Environment Variables
# Copy this file to .env.local and fill in the values

# [IMPORTANT] Do NOT use NEXT_PUBLIC_ for sensitive keys!
# These are handled server-side via Server Actions in app/actions/security.ts

# The word or phrase required to unlock the secrets page
AUTH_PASSPHRASE=your_passphrase_here

# The actual fingerprint shown after successful verification
FINGERPRINT=tu_fingerprint_aqui

# The server IP shown after successful verification
SERVER_IP=tu_ip_aqui:puerto
